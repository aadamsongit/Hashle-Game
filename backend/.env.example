NODE_ENV=development
PORT=4000

# Local Postgres started via docker-compose.yml
POSTGRES_USER=hashle
POSTGRES_PASSWORD=hashle
POSTGRES_DB=hashle
DATABASE_URL=postgresql://hashle:hashle@localhost:5432/hashle

SESSION_SECRET=change-me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Frontend origin, used for CORS and the OAuth redirect back
FRONTEND_URL=http://localhost:5173
